{
  "name": "brightshelf",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "prepare": "node scripts/prepare.mjs",
    "validate": "npm run typecheck --workspace api && npm run test --workspace api && npm run typecheck --workspace web && npm run lint --workspace web && npm run build --workspace web",
    "lint": "cd api && npx oxlint src/ && cd ../web && npx oxlint src/",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix"
    ],
    "*.{ts,tsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "next": "16.3.8",
    "oxlint": "^1.16.0",
    "prettier": "^3.6.0"
  }
}
