# Local Express server port.
NODE_ENV=development
PORT=4000
# Supabase runtime pooler connection string for Prisma queries.
DATABASE_URL=
# Direct or session-pooler connection string for Prisma migrations.
DIRECT_URL=
# Exact local web origin allowed by credentialed API CORS.
WEB_ORIGIN=http://localhost:3000
# Optional. Without Redis, rate limits are process-local and not shared across instances.
REDIS_URL=
# Only enables fictional demo purchases in non-production environments.
ALLOW_SYNTHETIC_CHECKOUT=false
# Shared API session signing secret. Needed when authentication is implemented.
JWT_SECRET=
# Google OAuth credentials. Needed when authentication is implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail SMTP settings for email sign-in.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Full Gmail address used to authenticate and send mail.
SMTP_USER=
# Gmail app password (not the Google account password).
SMTP_APP_PASSWORD=
# Optional sender address; defaults to the SMTP_USER address.
SMTP_FROM=
# Display name used when SMTP_FROM is not set.
SMTP_FROM_NAME=Brightshelf
# Stripe test-mode secret key. Never use a live key for this checkout flow.
STRIPE_SECRET_KEY=
# Signing secret from the Stripe test webhook endpoint or CLI forwarder.
STRIPE_WEBHOOK_SECRET=
# WebAuthn relying party settings. Use final production hostname/origin in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
