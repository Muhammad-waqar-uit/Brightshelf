# PostgreSQL connection string used by Prisma in the API.
# API port used by the local Express server.
PORT=4000
# PostgreSQL connection string used by Prisma in the API.
DATABASE_URL=
# Direct or session-pooler PostgreSQL connection string used for Prisma migrations.
DIRECT_URL=
# Legacy Auth.js secret; not used by the current custom session implementation.
AUTH_SECRET=
# Shared signing secret used to verify API session tokens.
JWT_SECRET=
# Google OAuth client ID.
GOOGLE_CLIENT_ID=
# Google OAuth client secret (web server and API verification).
GOOGLE_CLIENT_SECRET=
# Exact web callback URI registered in the Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Public API origin for browser-visible configuration.
NEXT_PUBLIC_API_URL=
# API origin used for server-side web requests.
API_URL=
# Web origin allowed by API CORS.
WEB_ORIGIN=
# Optional. Without Redis, rate limits are process-local and not shared across instances.
REDIS_URL=
# Only enables fictional demo purchases in non-production environments.
ALLOW_SYNTHETIC_CHECKOUT=false
# Stripe test-mode secret key, used only by the API.
STRIPE_SECRET_KEY=
# Stripe test webhook signing secret, used only by the API.
STRIPE_WEBHOOK_SECRET=
# WebAuthn relying party settings. Use final production hostname/origin in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# Gmail SMTP host used to deliver email codes and sign-in links.
SMTP_HOST=
# Gmail SMTP port, typically 465 or 587.
SMTP_PORT=
# Dedicated Gmail address used for SMTP authentication.
SMTP_USER=
# Gmail app password used for SMTP authentication.
SMTP_APP_PASSWORD=
# Sender address displayed on Brightshelf emails.
SMTP_FROM=
# Display name used for Brightshelf sign-in messages.
SMTP_FROM_NAME=Brightshelf
