# Shared inventory of environment variable names.
# Copy api/.env.example to api/.env and web/.env.example to web/.env.local.
# API port used by the local Express server.
PORT=4000
# PostgreSQL connection string used by Prisma in the API.
DATABASE_URL=
# Direct or session-pooler PostgreSQL connection string used for Prisma migrations.
DIRECT_URL=
# Auth.js secret used by the web application when authentication is implemented.
AUTH_SECRET=
# Shared signing secret used to verify API session tokens.
JWT_SECRET=
# Google OAuth client ID.
GOOGLE_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# API origin used only for server-side web requests.
API_URL=http://localhost:4000
# Web origin allowed by API CORS.
WEB_ORIGIN=http://localhost:3000
# WebAuthn relying party ID, usually the web hostname.
WEBAUTHN_RP_ID=
# Exact web origin used for WebAuthn ceremonies.
WEBAUTHN_ORIGIN=
# Gmail SMTP host used to deliver email codes and links.
SMTP_HOST=
# Gmail SMTP port, typically 465 or 587.
SMTP_PORT=
# Dedicated Gmail address used for SMTP authentication.
SMTP_USER=
# Gmail app password used for SMTP authentication.
SMTP_APP_PASSWORD=
# Sender address displayed on Brightshelf emails.
SMTP_FROM=
